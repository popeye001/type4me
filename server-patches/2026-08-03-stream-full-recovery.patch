 def _meaningful_text_length(text: str) -> int:
     """Count text progress without mistaking final punctuation for new words."""
     return len(text.rstrip("。！？!?;；，,、：:\"'“”‘’（）()《》【】 "))
+
+
+def _normalized_for_repetition(text: str) -> str:
+    """Remove presentation marks before checking decoder time-line repeats."""
+    return "".join(
+        char
+        for char in str(text or "")
+        if not char.isspace() and char not in "。！？!?;；，,、：:\"'“”‘’（）()《》【】"
+    )
+
+
+def _looks_like_repeated_append(before: str, after: str) -> bool:
+    """Detect a chunk that appends an earlier phrase instead of new audio."""
+    if not after.startswith(before) or len(after) <= len(before):
+        return False
+    prior = _normalized_for_repetition(before)
+    addition = _normalized_for_repetition(after[len(before) :])
+    if len(addition) < 6 or len(prior) < 6:
+        return False
+    if addition in prior:
+        return True
+    longest = SequenceMatcher(None, prior, addition, autojunk=False).find_longest_match()
+    return longest.size / len(addition) >= 0.75
 
 
